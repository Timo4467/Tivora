# ============================================================================
# Tivora Community Edition — Umgebungskonfiguration (Beispiel)
# ----------------------------------------------------------------------------
# Diese Datei nach `.env` kopieren ODER einfach `./install.sh` ausführen,
# das alle Secrets automatisch sicher erzeugt.
#
#   cp .env.example .env
#
# ⚠️ NIEMALS eine echte `.env` mit Secrets committen (siehe .gitignore).
# ============================================================================

# --- Öffentliche Anwendungs-URL -------------------------------------------
# Vollständige URL, unter der die Anwendung erreichbar ist.
APP_URL=https://dienstplan.example.com

# Host-Port, auf den der App-Container (intern 5000) gemappt wird.
APP_PORT=3000

# `true`, wenn die App über HTTPS erreichbar ist (z.B. hinter Reverse Proxy).
COOKIE_SECURE=false

# Zeitzone
TZ=Europe/Berlin

# Angezeigte Version (auch via ./manage.sh version)
APP_VERSION=1.0.0

# Docker-Image. Für den schnellen `docker pull`-Weg auf das veröffentlichte
# GHCR-Image zeigen lassen (dann `./install.sh --pull`); leer/lokaler Name
# lässt das Image lokal aus dem Quellcode bauen.
#   APP_IMAGE=ghcr.io/timo4467/tivora-community:latest
APP_IMAGE=ghcr.io/timo4467/tivora-community:1.0

# --- Datenbank -------------------------------------------------------------
# Owner-/Migrations-Rolle (DDL-Rechte). Läuft NUR im internen Docker-Netz.
POSTGRES_DB=tivora
POSTGRES_USER=tivora_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password

# Runtime-Rolle der App (NOBYPASSRLS → echte Row-Level-Security).
PG_APP_USER=tivora_app
PG_APP_PASSWORD=CHANGE_ME_app_password

# Row-Level-Security strikt (fail-closed). Für die Single-Tenant Community
# Edition auf false: DB-RLS-Policies bleiben aktiv, aber Pre-Auth-Login-Queries
# dürfen ohne Tenant-Kontext laufen (automatischer Bypass).
RLS_STRICT=false

# --- Secrets (vom Installer automatisch erzeugt) ---------------------------
# Session-Signaturschlüssel (min. 32 Zeichen).
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_session_secret_min_32_chars

# Master-Key für den verschlüsselten Vault (Integrations-Secrets).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=CHANGE_ME_vault_master_key

# Einmal-Token, das den web-basierten Ersteinrichtungs-Assistenten schützt.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SETUP_TOKEN=CHANGE_ME_setup_token

# --- Optional: Microsoft 365 / Entra ID SSO (Professional-Feature) ---------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
REDIRECT_URI=
